      "has": [
        {
          "type": "host",
          "value": "solarireland.org"
        }
      ],
      "destination": "https://solarirelandgroup.ie/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.solarireland.org"
        }
      ],
      "destination": "https://solarirelandgroup.ie/",
      "permanent": true
    },
    {
      "source": "/:path*",
