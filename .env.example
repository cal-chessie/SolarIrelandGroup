# ===========================================
# Solar Ireland — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.
#
# NEXT_PUBLIC_ vars are exposed to the browser.
# All other vars are server-side only.

# -------------------------------------------
# Required for AI features
# -------------------------------------------
# z-ai-web-dev-sdk (chat assistant, bill analyser)
# Provided by the platform — set automatically in hosted environments.
ZAI_API_KEY=

# -------------------------------------------
# Analytics & SEO
# -------------------------------------------
# Google Analytics 4 Measurement ID (optional)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -------------------------------------------
# PostHog (product analytics, session replay)
# -------------------------------------------
# Get these from https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog API host (use your EU region if applicable)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# -------------------------------------------
# Supabase
# -------------------------------------------
# Get these from https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous public key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY, never expose to client
# Used by: admin-dashboard API route, consent persistence, /api/lead fallback
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------
# AISolar lead intake (SERVER ONLY)
# -------------------------------------------
# Every website intake (home estimate, calculator, book-survey, exit-intent)
# posts to /api/lead, which forwards into AISolar's ingest-lead edge function.
# AISolar then scores the lead, estimates the system, and emails the branded
# estimate via Postmark automatically. Never expose these to the client.
#
# Full URL of the AISolar V5 ingest-lead function, e.g.
#   https://ywizcsulurxoqjdgnkvc.supabase.co/functions/v1/ingest-lead
AISOLAR_INGEST_URL=

# The Solar Ireland "source key" (x-source-key). Minted in AISolar's `sources`
# table for the solar-ireland brand/door; scoped to this brand and revocable.
AISOLAR_SOURCE_KEY=
